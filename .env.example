# Tapo camera sync config. Copy to .env and fill in.
# Real environment variables override values here.

# Login shared by every camera: the camera account you set in the Tapo app
# (Camera Settings > Advanced Settings > Camera Account).
TAPO_USER=admin
TAPO_PASSWORD=change-me
# Your TP-Link / Tapo cloud account password. Defaults to TAPO_PASSWORD.
TAPO_CLOUD_PASSWORD=change-me

# Folder everything is saved into (ignored in Docker, which always uses /data).
TAPO_OUTPUT=camera_data

# Time zone used for recording file names, mainly matters in Docker.
TZ=America/New_York

# One TAPO_CAMERA_<NAME>_HOST line per camera. <NAME> is just a label.
TAPO_CAMERA_FRONT_HOST=192.168.1.50

# Add more cameras like this. A camera with a different login can override it:
# TAPO_CAMERA_GARAGE_HOST=192.168.1.51
# TAPO_CAMERA_GARAGE_USER=admin
# TAPO_CAMERA_GARAGE_PASSWORD=other-password
# TAPO_CAMERA_GARAGE_CLOUD_PASSWORD=other-password
